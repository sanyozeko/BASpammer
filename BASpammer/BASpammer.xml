	<Frame name="BASpammer" toplevel="true" enableMouse="true" movable="true" parent="UIParent" hidden="false">
		<Size>
			<AbsDimension x="150" y="20"/>
		</Size>
		<Anchors>
			<Anchor point="CENTER" relativeTo="UIParent">
				<Offset>
					<AbsDimension x="0" y="0" />
				</Offset>
			</Anchor>
 		</Anchors>
		<Layers>
			<Layer>
				<FontString name="BASpammerText"  inherits="GameFontHighlight" text="BASpammer Off">
					<Size x="140" y="16"/>
					<Anchors>
						<Anchor point="TOP">
							<Offset>
								<AbsDimension x="0" y="-1" />
							</Offset>
						</Anchor>
					</Anchors>
					<FontString inherits="GameFontHighlight"/>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnMouseUp>
				if ( self.isMoving ) then
				  self:StopMovingOrSizing();
				  self.isMoving = false;
				  BASpammer:SavePosition(1)
				end
			</OnMouseUp>
			<OnMouseDown>
				if ( ( ( not self.isLocked ) or ( self.isLocked == 0 ) ) and ( arg1 == "LeftButton" ) ) then
				  self:StartMoving();
				  self.isMoving = true;
				end
				BASpammer:OnMouseDown(self,arg1)
			</OnMouseDown>
			<OnEnter>
				BASpammer:OnEnter()
			</OnEnter>
			<OnLeave>
				BASpammer:OnLeave()
			</OnLeave>
		</Scripts>
	</Frame>
